# Copy this file to .env (`cp .env.example .env`) and fill in the values below.
# .env is ignored by git, so your key can't be committed by accident.

# The key the app uses to reach its AI models through OpenRouter (https://openrouter.ai).
# Reviewers: the key is in the email that submitted this repo.
# Needed from the first start: each day of r/sailing history is sorted into topics with it.
OPENROUTER_API_KEY=

# The port the app is opened on in your browser: http://localhost:<PORT>.
# Change it only if something else on your machine already uses 5173.
PORT=5173
