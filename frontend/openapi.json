{
  "openapi": "3.1.0",
  "info": {
    "title": "Community Voices",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Report Health",
        "description": "Say whether every dependency answers, and name any that doesn't.",
        "operationId": "report_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/ingestion": {
      "get": {
        "summary": "Report Ingestion",
        "description": "How far the catch-up has got through the history.",
        "operationId": "report_ingestion",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Report Ingestion"
                }
              }
            }
          }
        }
      }
    },
    "/api/streams/{stream}/events": {
      "get": {
        "summary": "Stream Events",
        "description": "Live events as server-sent events (atlas plate 41).",
        "operationId": "stream_events",
        "parameters": [
          {
            "name": "stream",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Stream"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/days": {
      "get": {
        "summary": "Report Days",
        "description": "Posts and comments per day across the history, and the latest day loaded.",
        "operationId": "report_days",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Days"
                }
              }
            }
          }
        }
      }
    },
    "/api/topics": {
      "get": {
        "summary": "Report Topics",
        "description": "The topics with engagement in the range, busiest first, each with its badge.",
        "operationId": "report_topics",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "End"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TopicInRange"
                  },
                  "title": "Response Report Topics"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/map": {
      "get": {
        "summary": "Report Map",
        "description": "Every post and comment written in the range, placed on the range's own map.",
        "operationId": "report_map",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "End"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Map"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "post": {
        "summary": "Start Run",
        "description": "Starts a comparison for the range: both versions, then their scores (plate 70).",
        "operationId": "start_run",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStarted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}": {
      "get": {
        "summary": "Report Run",
        "description": "A run's state: running, finished with both versions and their scores, or failed.",
        "operationId": "report_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/topics/{topic_id}": {
      "get": {
        "summary": "Report Topic",
        "description": "One topic: its engagement each day across the history, its typical posts, and the\ntagging decisions that built it. 404 for a topic that doesn't exist.",
        "operationId": "report_topic",
        "parameters": [
          {
            "name": "topic_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Topic Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopicDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/retrievals": {
      "get": {
        "summary": "Report Retrievals",
        "description": "Which posts written in the range an agent retrieved most, and its retrievals per\ntopic; from one run, or from every run when none is named.",
        "operationId": "report_retrievals",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "End"
            }
          },
          {
            "name": "agent",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "report",
                "tagging"
              ],
              "type": "string",
              "default": "report",
              "title": "Agent"
            }
          },
          {
            "name": "run",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Run"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetrievalStats"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DayCount": {
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "title": "Day"
          },
          "posts": {
            "type": "integer",
            "title": "Posts"
          }
        },
        "type": "object",
        "required": [
          "day",
          "posts"
        ],
        "title": "DayCount"
      },
      "Days": {
        "properties": {
          "days": {
            "items": {
              "$ref": "#/components/schemas/DayCount"
            },
            "type": "array",
            "title": "Days"
          },
          "latest_day": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Day"
          }
        },
        "type": "object",
        "required": [
          "days",
          "latest_day"
        ],
        "title": "Days"
      },
      "EngagementDay": {
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "title": "Day"
          },
          "posts": {
            "type": "integer",
            "title": "Posts"
          },
          "comments": {
            "type": "integer",
            "title": "Comments"
          },
          "upvotes": {
            "type": "integer",
            "title": "Upvotes"
          },
          "people": {
            "type": "integer",
            "title": "People"
          }
        },
        "type": "object",
        "required": [
          "day",
          "posts",
          "comments",
          "upvotes",
          "people"
        ],
        "title": "EngagementDay",
        "description": "One day the topic had any engagement."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KeyTopic": {
        "properties": {
          "topic_id": {
            "type": "integer",
            "title": "Topic Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "rank": {
            "type": "integer",
            "title": "Rank"
          },
          "engagement": {
            "type": "integer",
            "title": "Engagement"
          },
          "direction": {
            "type": "string",
            "enum": [
              "new",
              "rising",
              "steady",
              "fading"
            ],
            "title": "Direction"
          }
        },
        "type": "object",
        "required": [
          "topic_id",
          "label",
          "description",
          "rank",
          "engagement",
          "direction"
        ],
        "title": "KeyTopic"
      },
      "Map": {
        "properties": {
          "points": {
            "items": {
              "$ref": "#/components/schemas/MapPoint"
            },
            "type": "array",
            "title": "Points"
          }
        },
        "type": "object",
        "required": [
          "points"
        ],
        "title": "Map"
      },
      "MapPoint": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "author": {
            "type": "string",
            "title": "Author"
          },
          "day": {
            "type": "string",
            "format": "date",
            "title": "Day"
          },
          "thread_title": {
            "type": "string",
            "title": "Thread Title"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          },
          "thread_topic_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thread Topic Id"
          },
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          }
        },
        "type": "object",
        "required": [
          "id",
          "thread_id",
          "kind",
          "author",
          "day",
          "thread_title",
          "excerpt",
          "thread_topic_id",
          "x",
          "y"
        ],
        "title": "MapPoint"
      },
      "NamedTopic": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "rank": {
            "type": "integer",
            "title": "Rank"
          },
          "direction": {
            "type": "string",
            "enum": [
              "new",
              "rising",
              "steady",
              "fading"
            ],
            "title": "Direction"
          }
        },
        "type": "object",
        "required": [
          "name",
          "rank",
          "direction"
        ],
        "title": "NamedTopic"
      },
      "PostCard": {
        "properties": {
          "post_id": {
            "type": "string",
            "title": "Post Id"
          },
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "author": {
            "type": "string",
            "title": "Author"
          },
          "day": {
            "type": "string",
            "format": "date",
            "title": "Day"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          }
        },
        "type": "object",
        "required": [
          "post_id",
          "thread_id",
          "kind",
          "author",
          "day",
          "title",
          "excerpt"
        ],
        "title": "PostCard",
        "description": "A thread's opening post, as a typical post's card shows it. A thread whose post isn't\nstored is shown by its title, under an unknown author."
      },
      "PredictedTopic": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "direction": {
            "type": "string",
            "enum": [
              "new",
              "rising",
              "steady",
              "fading"
            ],
            "title": "Direction"
          }
        },
        "type": "object",
        "required": [
          "name",
          "direction"
        ],
        "title": "PredictedTopic"
      },
      "RankedPost": {
        "properties": {
          "post_id": {
            "type": "string",
            "title": "Post Id"
          },
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "author": {
            "type": "string",
            "title": "Author"
          },
          "day": {
            "type": "string",
            "format": "date",
            "title": "Day"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          },
          "topic_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic Id"
          },
          "topic_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic Label"
          },
          "times_retrieved": {
            "type": "integer",
            "title": "Times Retrieved"
          },
          "last_retrieved": {
            "type": "string",
            "format": "date-time",
            "title": "Last Retrieved"
          },
          "rank": {
            "type": "integer",
            "title": "Rank"
          }
        },
        "type": "object",
        "required": [
          "post_id",
          "thread_id",
          "kind",
          "author",
          "day",
          "excerpt",
          "topic_id",
          "topic_label",
          "times_retrieved",
          "last_retrieved",
          "rank"
        ],
        "title": "RankedPost"
      },
      "RetrievalStats": {
        "properties": {
          "agent": {
            "type": "string",
            "enum": [
              "report",
              "tagging"
            ],
            "title": "Agent"
          },
          "runs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Runs"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "posts": {
            "items": {
              "$ref": "#/components/schemas/RankedPost"
            },
            "type": "array",
            "title": "Posts"
          },
          "topics": {
            "items": {
              "$ref": "#/components/schemas/TopicRetrievals"
            },
            "type": "array",
            "title": "Topics"
          }
        },
        "type": "object",
        "required": [
          "agent",
          "runs",
          "total",
          "posts",
          "topics"
        ],
        "title": "RetrievalStats"
      },
      "RunRequest": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date",
            "title": "End"
          }
        },
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "title": "RunRequest"
      },
      "RunResult": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "start": {
            "type": "string",
            "format": "date",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date",
            "title": "End"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "main_topics": {
            "items": {
              "$ref": "#/components/schemas/KeyTopic"
            },
            "type": "array",
            "title": "Main Topics"
          },
          "instructions": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Instructions"
          },
          "versions": {
            "items": {
              "$ref": "#/components/schemas/VersionResult"
            },
            "type": "array",
            "title": "Versions"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "start",
          "end",
          "model",
          "main_topics",
          "instructions",
          "versions"
        ],
        "title": "RunResult"
      },
      "RunStarted": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "stream": {
            "type": "string",
            "title": "Stream"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "stream"
        ],
        "title": "RunStarted"
      },
      "RunState": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "running",
              "finished",
              "failed"
            ],
            "title": "State"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "state"
        ],
        "title": "RunState"
      },
      "Scores": {
        "properties": {
          "main_topics": {
            "type": "integer",
            "title": "Main Topics"
          },
          "topics_found": {
            "type": "integer",
            "title": "Topics Found"
          },
          "topics_invented": {
            "type": "integer",
            "title": "Topics Invented"
          },
          "order_agreement": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Agreement"
          },
          "directions_named": {
            "type": "integer",
            "title": "Directions Named"
          },
          "directions_right": {
            "type": "integer",
            "title": "Directions Right"
          },
          "predicted_named": {
            "type": "integer",
            "title": "Predicted Named"
          },
          "predicted_prominent": {
            "type": "integer",
            "title": "Predicted Prominent"
          },
          "predicted_never_came_up": {
            "type": "integer",
            "title": "Predicted Never Came Up"
          },
          "predicted_direction_right": {
            "type": "integer",
            "title": "Predicted Direction Right"
          },
          "prediction_score": {
            "type": "number",
            "title": "Prediction Score"
          }
        },
        "type": "object",
        "required": [
          "main_topics",
          "topics_found",
          "topics_invented",
          "order_agreement",
          "directions_named",
          "directions_right",
          "predicted_named",
          "predicted_prominent",
          "predicted_never_came_up",
          "predicted_direction_right",
          "prediction_score"
        ],
        "title": "Scores"
      },
      "TopicDecision": {
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "title": "Day"
          },
          "decision": {
            "type": "string",
            "title": "Decision"
          },
          "threads": {
            "type": "integer",
            "title": "Threads"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "day",
          "decision",
          "threads",
          "reason"
        ],
        "title": "TopicDecision",
        "description": "One tagging decision that built the topic: minting it, or attaching threads to it."
      },
      "TopicDetail": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
